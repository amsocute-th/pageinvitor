{
  "manifest_version": 3,
  "name": "RaceGO FB Page Inviter",
  "version": "1.0",
  "description": "Automatically invite users who liked your posts to like your Facebook Page",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "host_permissions": [
    "*://*.facebook.com/*"
  ]
}
